rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Courses Collection — LOCKED (seeding complete)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_course_enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid || isAdmin();
      allow write: if isAuthenticated() && request.resource.data.user_id == request.auth.uid || isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid || isAdmin();
      allow write: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    match /leaderboard_view/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forum_posts/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /forum_replies/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /forum_post_votes/{docId} { allow read: if true; allow write: if isAuthenticated(); }
    match /forum_reply_votes/{docId} { allow read: if true; allow write: if isAuthenticated(); }

    match /messages/{docId} { allow read, write: if isAuthenticated(); }
    match /conversations/{docId} { allow read, write: if isAuthenticated(); }
    match /conversation_participants/{docId} { allow read, write: if isAuthenticated(); }
    match /mentor_conversations/{docId} { allow read, write: if isAuthenticated(); }
    match /mentor_messages/{docId} { allow read, write: if isAuthenticated(); }

    match /quiz_attempts/{docId} { allow read, write: if isAuthenticated(); }
    match /assessment_attempts/{docId} { allow read, write: if isAuthenticated(); }
    match /assignment_submissions/{docId} { allow read, write: if isAuthenticated(); }
    match /user_course_enrollments/{docId} { allow read, write: if isAuthenticated(); }
    match /user_module_progress/{docId} { allow read, write: if isAuthenticated(); }
    match /mls_user_progress/{docId} { allow read, write: if isAuthenticated(); }
    match /mls_bookmarks/{docId} { allow read, write: if isAuthenticated(); }
    match /user_roadmaps/{docId} { allow read, write: if isAuthenticated(); }
    match /roadmap_stages/{docId} { allow read, write: if isAuthenticated(); }
    match /roadmap_items/{docId} { allow read, write: if isAuthenticated(); }

    match /coding_submissions/{docId} { allow read, write: if isAuthenticated(); }
    match /contest_participants/{docId} { allow read, write: if isAuthenticated(); }
    match /coding_progress/{docId} { allow read, write: if isAuthenticated(); }
    match /coding_statistics/{docId} { allow read, write: if isAuthenticated(); }
    match /coding_streaks/{docId} { allow read, write: if isAuthenticated(); }

    match /user_activity_logs/{docId} { allow read, write: if isAuthenticated(); }
    match /activity_logs/{docId} { allow read, write: if isAuthenticated(); }
    match /certificates/{docId} { allow read, write: if isAuthenticated(); }
    match /user_followers/{docId} { allow read, write: if isAuthenticated(); }
    match /payment_orders/{docId} { allow read, write: if isAuthenticated(); }

    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
